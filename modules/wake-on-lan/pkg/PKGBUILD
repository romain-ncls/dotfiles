prepare() {
	mkdir -p igc
	for _f in "${_files[@]}"; do
		cp "igc-$_kver-$_f" "igc/$_f"
	done
	patch -d igc -p1 < allow-100-in-d3.patch
}

package() {
	local series=${_kver%.*}
	local dest="$pkgdir/usr/src/igc-wol-$pkgver-$pkgrel"
	install -Dm644 -t "$dest" igc/*
	sed -e "s/@VERSION@/$pkgver-$pkgrel/" -e "s/@SERIES@/${series//./\\\\.}/" \
		dkms.conf > "$dest/dkms.conf"
}
