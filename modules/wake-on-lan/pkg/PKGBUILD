# Local package: lodestar builds it when this folder changes. igc, the driver
# of the Intel I225/I226, from the kernel's source with one patch
# (allow-100-in-d3.patch) so a sleeping card keeps a link Wake-on-LAN can use:
# docs/wake-on-lan.md. DKMS builds it for each kernel of _kver's series; for
# another series it builds nothing and Arch's igc loads.
# To follow a new series: set _kver to its latest release, run updpkgsums,
# and check the patch still applies.
pkgname=igc-wol-dkms
_kver=7.3.4
pkgver=$_kver
pkgrel=1
pkgdesc='igc (Intel I225/I226) keeping a 100 Mbit/s link asleep, for Wake-on-LAN (DKMS)'
arch=(any)
url='https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/drivers/net/ethernet/intel/igc'
license=(GPL-2.0-only)
depends=(dkms)
_files=(Makefile igc.h igc_base.c igc_base.h igc_defines.h igc_diag.c igc_diag.h
        igc_dump.c igc_ethtool.c igc_hw.h igc_i225.c igc_i225.h igc_leds.c igc_mac.c
        igc_mac.h igc_main.c igc_nvm.c igc_nvm.h igc_phy.c igc_phy.h igc_ptp.c
        igc_regs.h igc_tsn.c igc_tsn.h igc_xdp.c igc_xdp.h)
source=(dkms.conf allow-100-in-d3.patch)
for _f in "${_files[@]}"; do
	source+=("igc-$_kver-$_f::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/net/ethernet/intel/igc/$_f?h=v$_kver")
done
