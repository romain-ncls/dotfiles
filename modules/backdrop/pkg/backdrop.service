[Unit]
Description=Backdrop wallpapers
PartOf=graphical-session.target
After=graphical-session.target
# In both sessions: it only fills ~/.local/share/backdrop, which Plasma's
# wallpaper plugin and shadesmar's Wallpaper.qml both show.

[Service]
ExecStart=/usr/bin/backdrop daemon
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
