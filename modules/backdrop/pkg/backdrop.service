[Unit]
Description=Backdrop wallpapers
PartOf=graphical-session.target
After=graphical-session.target
# Plasma only for now: it sets Plasma's wallpaper (docs/hyprland.md)
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
ExecStart=/usr/bin/backdrop daemon
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
