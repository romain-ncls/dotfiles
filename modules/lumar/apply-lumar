#!/bin/sh
# lumar's colors, from its own knobs (palette.json here: hue, tint, depth,
# accent, as Nalthis has, but lumar's), which `nalthis tokens` turns into
# colors: the same maths as Nalthis's, other knobs. Writes, when they change:
#   ~/.local/share/lumar/palette.json   shadesmar reads it, and follows it live
#   ~/.local/share/lumar/colors.lua     Hyprland's config requires it
#   ~/.config/ghostty/themes/lumar      Ghostty's theme (reread on SIGUSR2)
# and the files both sessions read, in the colors of the session it runs
# in (lumar's in Hyprland, Nalthis's in Plasma):
#   ~/.config/gtk-{3,4}.0/nalthis.css   GTK's palette (`nalthis gtk`)
#   ~/.local/share/lumar/brave-theme    Brave's theme, reread when it starts
# Run by lodestar on every apply, by lumar-session.service at each login
# (before the autostarted apps), and by lumar-palette.path when the knobs
# change. `apply-lumar set hue=262 depth=0.04` saves knobs and applies them.
set -eu

here=$(dirname "$(realpath "$0")")
knobsfile=$here/palette.json

if [ "${1:-}" = set ]; then
	shift
	for kv in "$@"; do
		key=${kv%%=*} value=${kv#*=}
		case $key in
		hue | tint | depth | accent) ;;
		*)
			echo "lumar: knobs are hue, tint, depth and accent" >&2
			exit 1
			;;
		esac
		jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$knobsfile" > "$knobsfile.new"
		mv "$knobsfile.new" "$knobsfile"
	done
fi

if ! command -v nalthis >/dev/null; then
	echo "lumar: no nalthis yet, lodestar apply builds it" >&2
	exit 0
fi
knobs=$(jq -r '"\(.hue) \(.tint) \(.depth) \(.accent)"' "$knobsfile")
# shellcheck disable=SC2086 # four numbers
tokens=$(nalthis tokens $knobs)

# The session's own knobs, for the files both sessions read.
if [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ]; then
	session=$knobs
	session_tokens=$tokens
else
	session=$(nalthis get | jq -r '.knobs | "\(.hue) \(.tint) \(.depth) \(.accent)"')
	# shellcheck disable=SC2086 # four numbers
	session_tokens=$(nalthis tokens $session)
fi

# The terminal: about Konsole's Nalthis background (#282e36 at the first
# knobs; the pane since they lightened, 2026-11-04) and its text (the second
# text color), with the colors picked on the lumar page
# (2026-11-04): fixed hues; black and white follow the palette.
# And the warning colors.
palette=$(printf '%s' "$tokens" | jq '. + {
	red: "#e66e68", green: "#74c878", yellow: "#eec05b",
	ansi: [.overlay, "#f07f77", "#67bb6b", "#eebc4a", "#65a7fa", "#cb86db", "#48b7bd", .text2,
	       .text3, "#fd9c94", "#78d47c", "#fed16f", "#8bbeff", "#e599f6", "#52d0d6", .text]
}')

data=${XDG_DATA_HOME:-$HOME/.local/share}/lumar
themes=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes
mkdir -p "$data" "$themes" "${XDG_STATE_HOME:-$HOME/.local/state}/lumar"

changed=false
# put PATH CONTENT: writes the content if it differs (an argument, not a
# pipe: a pipe would run this in a subshell and lose `changed`)
put() {
	printf '%s\n' "$2" > "$1.new"
	if cmp -s "$1.new" "$1"; then
		rm "$1.new"
	else
		mv "$1.new" "$1"
		changed=true
	fi
}

put "$data/palette.json" "$palette"

put "$data/colors.lua" "$(printf '%s' "$palette" | jq -r '
	"-- lumar'"'"'s colors, written by modules/lumar/apply-lumar",
	"return {",
	(to_entries[] | select(.value | type == "string") | "    \(.key) = \"\(.value)\","),
	"}"')"

put "$themes/lumar" "$(printf '%s' "$palette" | jq -r '
	"# lumar, written by modules/lumar/apply-lumar",
	"background = \(.pane)",
	"foreground = \(.text2)",
	"cursor-color = \(.accentText)",
	"selection-background = \(.accent)",
	"selection-foreground = \(.text)",
	(.ansi | to_entries[] | "palette = \(.key)=\(.value)")')"

# Brave's theme, its Classic layout in the session's colors: the tab strip
# the frame (as the bar), the active tab and toolbar the pane (as Plasma's
# title bars and toolbars), the address bar and new tab the base. Loaded
# unpacked once (docs/manual-steps.md); Brave rereads it when it starts.
mkdir -p "$data/brave-theme"
put "$data/brave-theme/manifest.json" "$(printf '%s' "$session_tokens" | jq '
	def byte: explode | map(if . >= 97 then . - 87 elif . >= 65 then . - 55 else . - 48 end) | .[0] * 16 + .[1];
	def rgb: ltrimstr("#") | [.[0:2], .[2:4], .[4:6]] | map(byte);
	{
		manifest_version: 3,
		name: "Lumar",
		description: "Brave in lumar'"'"'s colors, written by modules/lumar/apply-lumar",
		version: "1",
		theme: { colors: {
			frame: (.frame | rgb), frame_inactive: (.frame | rgb),
			frame_incognito: (.frame | rgb), frame_incognito_inactive: (.frame | rgb),
			background_tab: (.frame | rgb), background_tab_inactive: (.frame | rgb),
			toolbar: (.pane | rgb), toolbar_text: (.text | rgb), toolbar_button_icon: (.text2 | rgb),
			tab_text: (.text | rgb), tab_background_text: (.text2 | rgb), tab_background_text_inactive: (.text3 | rgb),
			bookmark_text: (.text2 | rgb),
			omnibox_background: (.base | rgb), omnibox_text: (.text | rgb),
			ntp_background: (.base | rgb), ntp_text: (.text | rgb), ntp_link: (.accentText | rgb)
		} }
	}')"

# GTK's palette, in the session's colors (Nautilus, Papers… read it when
# they start).
# shellcheck disable=SC2086 # four numbers
nalthis gtk "${XDG_CONFIG_HOME:-$HOME/.config}" $session

if $changed; then
	# Ghostty rereads its config; shadesmar follows palette.json by itself;
	# Hyprland takes its background from colors.lua
	for p in $(pgrep -x ghostty); do kill -USR2 "$p" 2>/dev/null || true; done
	hyprctl reload >/dev/null 2>&1 || true
	echo "lumar: colors written"
fi
