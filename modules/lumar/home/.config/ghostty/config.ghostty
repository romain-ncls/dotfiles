# Ghostty, in lumar's colors (modules/lumar; docs/hyprland.md): the theme is
# written by apply-lumar from the palette both sessions share.
theme = lumar
font-family = Fira Code
font-size = 11
# no title bar: the window as close to the tile as it gets (Hyprland draws
# no decorations either)
window-decoration = none
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
cursor-style-blink = false
# lumar's glass, as Brave's new tab's islands (modules/new-tab) and shadesmar's
# bar: the base (apply-lumar's theme) at 86 %, blurred behind (by Hyprland,
# lumar.lua; by KWin in Plasma). Ghostty blends in linear light: its 86 %
# looks as the bar's 83 %. What an app paints itself (Neovim's background)
# stays opaque.
background-opacity = 0.86
background-blur = true
