#!/bin/sh
# The company VPNs ("Agora", "Agora SG IHM", imported by hand: their files
# hold the keys) name their servers on their own DNS server, which speaks
# plain DNS only. Against the dns module's defaults: no DNS-over-TLS on
# that link, and its DNS first for every name while connected (~.), as
# NixOS did.
for vpn in "Agora" "Agora SG IHM"; do
	nmcli -t -f NAME connection show | grep -qx "$vpn" || continue
	[ "$(nmcli -g connection.dns-over-tls,ipv4.dns-search,ipv4.dns-priority connection show "$vpn" | paste -sd:)" = "0:~.:-50" ] && continue
	nmcli connection modify "$vpn" connection.dns-over-tls no ipv4.dns-search "~." ipv4.dns-priority -50
done
