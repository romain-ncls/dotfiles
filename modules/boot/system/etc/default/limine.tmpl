TARGET_OS_NAME="Arch Linux"
ESP_PATH="/boot"
ENABLE_VERIFICATION=yes
BOOT_ORDER="*, *fallback, Snapshots"
SNAPPER_CONFIG_NAME="root"
ROOT_SUBVOLUME_PATH="/@"
ROOT_SNAPSHOTS_PATH="/@snapshots"
MAX_SNAPSHOT_ENTRIES=8
LIMIT_USAGE_PERCENT=75
RESTORE_METHOD=replace
HASH_FUNCTION=xxhash
TERMINAL=konsole
FIND_BOOTLOADERS=no
ENABLE_LIMINE_FALLBACK=yes
{{- if eq (index .vars "secureboot") "yes" }}
# Secure Boot (the secureboot module): the BLAKE2B hash of limine.conf is
# enrolled into Limine's EFI binary, which sbctl then signs. Limine then
# refuses a modified config, any file without its hash, and the editor.
ENABLE_ENROLL_LIMINE_CONFIG=yes
{{- end }}
