{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "--init", "--pull=always", "--network", "host",
        "mcr.microsoft.com/playwright/mcp"
      ],
      "env": {}
    },
    "hion": {
      "type": "http",
      "url": "https://hion.romainncls.dev/mcp",
      "headersHelper": "sh ~/.claude/hion-mcp-headers.sh"
    }
  }
}
