{
  "name": "mutectl",
  "description": "Keeps the Teams microphone in step with mutectl.",
  "version": "1.1",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "mutectl: not on Teams",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "js": ["teams.js"],
      "matches": [
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ]
    }
  ]
}
