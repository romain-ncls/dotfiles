[Unit]
Description=spanreed: shadesmar's D-Bus helper (Plasma's OSD service, the Bluetooth pairing agent)
PartOf=graphical-session.target
After=graphical-session.target
# in Plasma, plasmashell owns the name
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
# not Type=dbus with BusName=org.kde.plasmashell: Plasma's
# plasma-plasmashell.service declares that name, and systemd refuses a second
# unit with it ("Two services allocated for the same bus name")
Type=exec
ExecStart=/usr/bin/spanreed
Restart=on-failure

[Install]
WantedBy=hyprland-session.target
