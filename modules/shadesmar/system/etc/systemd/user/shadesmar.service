# shadesmar, in the Hyprland session (modules/shadesmar).
[Unit]
Description=shadesmar, the Hyprland session's shell
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=/usr/bin/qs -c shadesmar
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
