#!/usr/bin/env bash
# Flat pointer acceleration for every mouse KDE has seen or can see now.
# KDE stores acceleration per device ([Libinput][vendor][product][name] in
# kcminputrc) and has no global switch, so this writes the key for each
# connected pointer and for every device already listed. Runs on each
# `lodestar apply`; a new mouse is covered at the next apply.
set -euo pipefail

declare -A seen

# connected mice: kernel input devices whose handlers include "mouse"
while IFS=$'\t' read -r vendor product name; do
	seen["$((16#$vendor))|$((16#$product))|$name"]=1
done < <(awk '
	/^I:/ { for (i = 1; i <= NF; i++) { split($i, kv, "="); if (kv[1] == "Vendor") v = kv[2]; if (kv[1] == "Product") p = kv[2] } }
	/^N:/ { sub(/^N: Name="/, ""); sub(/"$/, ""); n = $0 }
	/^H:/ && /mouse/ { if (v != "0000") print v "\t" p "\t" n }
' /proc/bus/input/devices)

# devices KDE already has a [Libinput] section for
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/kcminputrc
if [[ -f $cfg ]]; then
	while IFS= read -r line; do
		[[ $line =~ ^\[Libinput\]\[([0-9]+)\]\[([0-9]+)\]\[(.*)\]$ ]] || continue
		seen["${BASH_REMATCH[1]}|${BASH_REMATCH[2]}|${BASH_REMATCH[3]}"]=1
	done <"$cfg"
fi

for dev in "${!seen[@]}"; do
	IFS='|' read -r v p n <<<"$dev"
	kwriteconfig6 --file kcminputrc --group Libinput --group "$v" --group "$p" --group "$n" \
		--key PointerAccelerationProfile 1
done

# KWin only reads kcminputrc when a device appears; push it to live devices
# too: the flat profile, and the speed kcminputrc has for that device
busctl --user status org.kde.KWin >/dev/null 2>&1 || exit 0
prop() { busctl --user get-property org.kde.KWin "$1" org.kde.KWin.InputDevice "$2" | cut -d' ' -f2-; }
for path in $(busctl --user tree org.kde.KWin | grep -oE '/org/kde/KWin/InputDevice/event[0-9]+'); do
	[[ $(prop "$path" pointer) == true ]] || continue
	busctl --user set-property org.kde.KWin "$path" org.kde.KWin.InputDevice pointerAccelerationProfileFlat b true
	name=$(prop "$path" name)
	name=${name#\"} name=${name%\"}
	speed=$(kreadconfig6 --file kcminputrc --group Libinput --group "$(prop "$path" vendor | cut -d' ' -f1)" \
		--group "$(prop "$path" product | cut -d' ' -f1)" --group "$name" --key PointerAcceleration)
	[[ -n $speed ]] && busctl --user set-property org.kde.KWin "$path" org.kde.KWin.InputDevice pointerAcceleration d "$speed"
done
