#!/bin/sh
# The session's lock screen (docs/hyprland.md), hypridle's lock_cmd: Meta+L, the idle, the lid,
# sleep and mutectl's Lock AFK all go through `loginctl lock-session`. The Silksong one
# (modules/silksong: `qs -c silksong-lock`; away from the office desk, with Backdrop's picture in
# place of its world), else hyprlock: without its PAM service, if it quits
# (no game's art) or hasn't locked within 5 seconds, or should it end while locked (the session
# stays locked; hyprlock takes the lock over, misc.allow_session_lock_restore). One at a time.
# While it runs, logind's LockedHint is set, as Plasma's locker does: what tells either
# desktop is locked (mutectl's lock-afk).
pidof hyprlock > /dev/null && exit 0
qs list -c silksong-lock 2>/dev/null | grep -q '^Instance' && exit 0
hint() {
    busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
        org.freedesktop.login1.Session SetLockedHint b "$1" 2> /dev/null
}
hint true
trap 'hint false' EXIT
[ -e /etc/pam.d/silksong-lock ] || { hyprlock; exit; }
marker=${XDG_RUNTIME_DIR:-/tmp}/silksong-lock.locked # touched once every screen shows it
rm -f "$marker"
# Traced once: with this file there, the next lock logs each screen's frames (Qt's render loop
# timing) in Quickshell's log.log; the file goes as it's read, so the log stays small.
trace=${XDG_RUNTIME_DIR:-/tmp}/silksong-lock.trace
if [ -e "$trace" ]; then
    rm -f "$trace"
    export QT_LOGGING_RULES="qt.scenegraph.time.renderloop=true;qt.scenegraph.general=true"
fi
# The world is made for the office desk: the laptop's panel between the two BenQs, nothing else
# plugged in. Those are the screens grid.lua binds desktops 1 and 5 and comms to (monitors.lua's
# left, right and laptop), read from Hyprland's workspace rules (`desc:`: the start of a screen's
# description). Anywhere else, the lock shows Backdrop's picture in its place, as the desktop does
# (modules/backdrop: the only file of its current/, else the newest liked one); none, the world.
at_desk() {
    hyprctl -j workspacerules | jq -e --argjson screens "$(hyprctl -j monitors)" '
        def plugged($sel): [$screens[] | select(if $sel | startswith("desc:")
            then .description | startswith($sel[5:]) else .name == $sel end)] | length == 1;
        [.[] | select(.workspaceString == "1" or .workspaceString == "5"
            or .workspaceString == "name:comms") | .monitor] as $desk
        | ($desk | length) == 3 and ($screens | length) == 3 and all($desk[]; plugged(.))' \
        > /dev/null 2>&1
}
picture() {
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/backdrop/current" "$HOME/Pictures/Backdrop"; do
        f=$(ls -t "$dir"/*.jpg "$dir"/*.jpeg "$dir"/*.png "$dir"/*.webp 2> /dev/null | head -n 1)
        [ -n "$f" ] && { echo "$f"; return; }
    done
}
unset SILKSONG_LOCK_PICTURE
at_desk || { SILKSONG_LOCK_PICTURE=$(picture); export SILKSONG_LOCK_PICTURE; }
qs -n -c silksong-lock &
pid=$!
i=0
while [ ! -e "$marker" ] && kill -0 "$pid" 2> /dev/null && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ ! -e "$marker" ]; then
    kill "$pid" 2> /dev/null
    hyprlock
    exit
fi
wait "$pid"
status=$?
rm -f "$marker"
[ "$status" -eq 0 ] || hyprlock
