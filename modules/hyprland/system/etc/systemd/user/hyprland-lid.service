# The lid in Hyprland, as Plasma has it on wandersail: logind leaves it to
# the binds while Hyprland runs (binds.lua: nothing at the desk, a lock on
# the charger, suspend on battery).
[Unit]
Description=Lid handled by Hyprland's binds
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=systemd-inhibit --what=handle-lid-switch --who=Hyprland --why="Hyprland's binds handle the lid" sleep infinity

[Install]
WantedBy=hyprland-session.target
