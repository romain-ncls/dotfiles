# The lid and the Sleep key in Hyprland, as Plasma has them on wandersail:
# logind leaves them to the binds while Hyprland runs (session.lua: the lid
# does nothing at the desk, locks on the charger, suspends on battery; the
# Sleep key is mutectl's Lock AFK, not a suspend).
[Unit]
Description=Lid and Sleep key handled by Hyprland's binds
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=systemd-inhibit --what=handle-lid-switch:handle-suspend-key --who=Hyprland --why="Hyprland's binds handle them" sleep infinity

[Install]
WantedBy=hyprland-session.target
