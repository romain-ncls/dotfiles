#!/usr/bin/env python3
"""Merge the hand-written part of /boot/limine.conf with the generated part.

    limine-conf diff  REPO_FILE   show what apply would change (exit 1 if anything)
    limine-conf apply REPO_FILE   write it, then re-enroll the hash with limine-update

REPO_FILE holds the global options and the hand-written top-level entries
(e.g. Windows). Every other top-level entry in the live file is generated by
limine-entry-tool and kept as it is. Needs root: /boot is mode 700.
"""
import difflib, re, shutil, subprocess, sys

LIVE = "/boot/limine.conf"


def split(text):
    """-> (global lines, [entry blocks]); an entry starts at a line '/Title'."""
    glob, entries, cur = [], [], None
    for line in text.splitlines():
        if re.match(r"^/[^/]", line):
            cur = [line]
            entries.append(cur)
        elif cur is None:
            if not line.startswith("#"):  # repo-file comments stay in the repo
                glob.append(line)
        else:
            cur.append(line)
    return glob, entries


def trim(block):
    block = list(block)
    while block and not block[-1].strip():
        block.pop()
    while block and not block[0].strip():
        block.pop(0)
    return block


def merged(repo_text, live_text):
    rglob, rentries = split(repo_text)
    _, lentries = split(live_text)
    mine = {e[0] for e in rentries}
    generated = [e for e in lentries if e[0] not in mine]
    out = trim(rglob) + [""]
    for e in generated + rentries:
        out += trim(e) + [""]
    return "\n".join(out)


mode, repo = sys.argv[1], sys.argv[2]
live = open(LIVE).read()
new = merged(open(repo).read(), live)
if new.strip() == live.strip():
    print(f"{LIVE}: in sync")
    sys.exit(0)

sys.stdout.writelines(difflib.unified_diff(
    live.splitlines(True), new.splitlines(True), LIVE + " (live)", LIVE + " (repo)"))
if mode == "diff":
    sys.exit(1)

shutil.copy2(LIVE, LIVE + ".bak")
with open(LIVE, "w") as f:
    f.write(new)
subprocess.run(["limine-update"], check=True)  # re-enrolls the config hash
print(f"{LIVE}: updated (previous version in {LIVE}.bak)")
