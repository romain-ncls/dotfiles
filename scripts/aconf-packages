#!/usr/bin/env bash
# Print the packages system/*.sh declares for this host, one per line.
#   aconf-packages            all packages
#   aconf-packages --native   repository packages only
#   aconf-packages --foreign  AUR packages only
# Sources the config with stub helpers, so per-host guards are honoured and no
# root is needed. Set HOSTNAME to evaluate it for another machine (the
# installer does this from the live USB).
set -euo pipefail
dir=$(dirname "$(readlink -f "$0")")/../system
want=${1:-all}

AddPackage() {
	local kind=native
	[[ $1 == --foreign ]] && { kind=foreign; shift; }
	[[ $want == all || $want == "--$kind" ]] && echo "$1"
	return 0
}
RemovePackage() { :; }
IgnorePackage() { :; }
IgnorePath() { :; }
CopyFile() { :; }
CopyFileTo() { :; }
CreateFile() { cat >/dev/null; echo /dev/null; }
CreateDir() { :; }
CreateLink() { :; }
RemoveFile() { :; }
SetFileProperty() { :; }

for f in "$dir"/*.sh; do
	# shellcheck source=/dev/null
	source "$f"
done | sort -u
