[user]
	name = {{ .name }}
	email = {{ .email }}
	# each machine signs with its own key; see docs/manual-steps.md
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
[fetch]
	prune = true
[rebase]
	autostash = true
[diff]
	algorithm = histogram
[core]
	editor = vim
[rerere]
	enabled = true
[log]
	date = iso
