{
  "libraryGroupBy": "series",
  "bookshelves": { "rows": { "recent": { "fields_jsonb": { "definition": { "v": { "skeuomorphicCovers": true } } } } } },
  "globalViewSettings": {
    "uiLanguage": "en",
    "translateTargetLang": "fr",
