#!/usr/bin/env bash

mute=${1:-mute}

main() {
  if [[ "$mute" == "mute" ]]; then
    mute
  elif [[ "$mute" == "unmute" ]]; then
    unmute
  elif [[ "$mute" == "afk" ]]; then
    afk
  else
    echo "no command!"
  fi
}

mute() {
  muteClients
  muteHeadphones
}

unmute() {
  unmuteClients
  unmuteHeadphones

  if isVolumeTooMuch; then
    qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause
  fi
}

afk() {
  afkClients
  muteHeadphones
  qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause || :
}

muteClients() {
  curl -X POST http://127.0.0.1:4815/mute
}

unmuteClients() {
  curl -X POST http://127.0.0.1:4815/unmute
}

afkClients() {
  curl -X POST http://127.0.0.1:4815/afk
}

muteHeadphones() {
  amixer set Capture nocap
}

unmuteHeadphones() {
  amixer set Capture cap
}

isVolumeTooMuch() {
  volume=`qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Volume || echo 0`

  isMore=`echo "$volume > 0.31" | bc -l`

  [ $isMore -eq '1' ] && return 0 || return 1
}

main
