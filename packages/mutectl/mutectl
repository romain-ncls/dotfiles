#!/usr/bin/env bash

mute=${1:-mute}

main() {
  if [[ "$mute" == "mute" ]]; then
    mute
  elif [[ "$mute" == "unmute" ]]; then
    unmute
  elif [[ "$mute" == "no-mic" ]]; then
    nomic
  elif [[ "$mute" == "afk" ]]; then
    afk
  else
    echo "no command!"
  fi
}

mute() {
  muteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Dell_Inc_AWPRO" ]]; then
    muteHeadphones
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    nomicEar2
  else
    echo 'unknown device!'
  fi
}

unmute() {
  unmuteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Dell_Inc_AWPRO" ]]; then
    unmuteHeadphones
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    unmuteEar2
  else
    echo 'unknown device!'
  fi

  if isVolumeTooMuch; then
    qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause
  fi
}

nomic() {
  muteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Dell_Inc_AWPRO" ]]; then
    muteHeadphones
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    nomicEar2
  else
    echo 'unknown device!'
  fi
}

afk() {
  afkClients
  qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause || :
}

muteClients() {
  curl -X POST http://127.0.0.1:4815/mute
}

unmuteClients() {
  curl -X POST http://127.0.0.1:4815/unmute
}

afkClients() {
  curl -X POST http://127.0.0.1:4815/afk
}

muteHeadphones() {
  amixer set Capture nocap
}

unmuteHeadphones() {
  amixer set Capture cap
}

nomicEar2() {
  pactl set-card-profile bluez_card.2C_BE_EB_47_6F_2A a2dp-sink
}

unmuteEar2() {
  pactl set-card-profile bluez_card.2C_BE_EB_47_6F_2A headset-head-unit
}

isVolumeTooMuch() {
  volume=`qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Volume || echo 0`

  isMore=`echo "$volume > 0.45" | bc -l`

  [ $isMore -eq '1' ] && return 0 || return 1
}

main
