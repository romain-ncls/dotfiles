#!/usr/bin/env bash

mute=${1:-mute}

main() {
  if [[ "$mute" == "mute" ]]; then
    mute
  elif [[ "$mute" == "unmute" ]]; then
    unmute
  elif [[ "$mute" == "no-mic" ]]; then
    nomic
  else
    echo "no command!"
  fi
}

mute() {
  muteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Poly_BT600" ]]; then
    muteHeadset
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    nomicEar2
  else
    echo 'unknown device!'
  fi
}

unmute() {
  unmuteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Poly_BT600" ]]; then
    unmuteHeadset
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    unmuteEar2
  else
    echo 'unknown device!'
  fi

  if isVolumeTooMuch; then
    qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause
  fi
}

nomic() {
  muteClients

  defaultDevice=$(pactl get-default-sink)
  if [[ "$defaultDevice" =~ "Poly_BT600" ]]; then
    nomicHeadset
  elif [[ "$defaultDevice" =~ "2C_BE_EB_47_6F_2A" ]]; then
    nomicEar2
  else
    echo 'unknown device!'
  fi
}

muteClients() {
  curl -X POST http://127.0.0.1:4815/mute
}

unmuteClients() {
  curl -X POST http://127.0.0.1:4815/unmute
}

nomicHeadset() {
  pactl set-card-profile alsa_card.usb-Plantronics_Poly_BT600_064e0dab8f85441c958b643739ca9cdc-00 output:analog-stereo
}

muteHeadset() {
  pactl set-card-profile alsa_card.usb-Plantronics_Poly_BT600_064e0dab8f85441c958b643739ca9cdc-00 output:analog-stereo+input:mono-fallback

  amixer set Capture nocap
}

unmuteHeadset() {
  pactl set-card-profile alsa_card.usb-Plantronics_Poly_BT600_064e0dab8f85441c958b643739ca9cdc-00 output:analog-stereo+input:mono-fallback

  amixer set Capture cap
}

nomicEar2() {
  pactl set-card-profile bluez_card.2C_BE_EB_47_6F_2A a2dp-sink
}

unmuteEar2() {
  pactl set-card-profile bluez_card.2C_BE_EB_47_6F_2A headset-head-unit
}

isVolumeTooMuch() {
  volume=`qdbus org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Volume || echo 0`

  isMore=`echo "$volume > 0.45" | bc -l`

  [ $isMore -eq '1' ] && return 0 || return 1
}

main
